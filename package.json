{
  "name": "netpulse-networking",
  "version": "2.4.0",
  "description": "Enterprise Network Observability, Simulation & Protocol Diagnostics Suite",
  "main": "server/main.py",
  "scripts": {
    "start": "python server/main.py --host 0.0.0.0 --port 8080",
    "build": "python -m py_compile server/main.py",
