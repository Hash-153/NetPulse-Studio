    "lint": "flake8 server/ client/",
    "docker:build": "docker build -t netpulse-suite:latest .",
    "docker:run": "docker-compose up -d"
  },
  "keywords": [
    "networking",
    "bgp",
    "ospf",
    "sdn",
    "openflow",
    "packet-inspector",
    "wireshark",
    "firewall",
    "diagnostics"
  ],
  "author": "NetPulse Engineering",
  "private": true
}
